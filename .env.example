# Copy to .env and replace placeholder passwords locally. Never commit .env.
MYSQL_DATABASE=securepdf
MYSQL_USER=securepdf_user
MYSQL_PASSWORD=replace_with_a_local_development_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password
MYSQL_PORT=3306

# Use the same local development password as MYSQL_PASSWORD below.
DATABASE_URL=mysql+pymysql://securepdf_user:replace_with_a_local_development_password@localhost:3306/securepdf
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

JWT_SECRET_KEY=replace-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30